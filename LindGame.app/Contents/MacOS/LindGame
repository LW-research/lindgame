#!/bin/bash
# ====================================================================
# Catch! Teenieping Magic Academy - Native macOS App Launcher
# ====================================================================
DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$DIR"

# Identify Python command
if [ -n "$CONDA_PREFIX" ] && [ -x "$CONDA_PREFIX/bin/python" ]; then
    PYTHON_CMD="$CONDA_PREFIX/bin/python"
elif [ -x "$HOME/miniconda3/envs/py312_rsrch/bin/python" ]; then
    PYTHON_CMD="$HOME/miniconda3/envs/py312_rsrch/bin/python"
else
    PYTHON_CMD=""
    for cand in python3 \
                "$HOME/miniconda3/envs/py312_rsrch/bin/python" \
                "$HOME/miniconda3/bin/python" \
                "$HOME/miniforge3/bin/python" \
                "$HOME/opt/anaconda3/bin/python" \
                /opt/homebrew/bin/python3 \
                /usr/local/bin/python3; do
        if command -v "$cand" &>/dev/null || [ -x "$cand" ]; then
            if "$cand" -c "import edge_tts" &>/dev/null 2>&1; then
                PYTHON_CMD="$cand"
                break
            fi
        fi
    done

    if [ -z "$PYTHON_CMD" ]; then
        if command -v python3 &>/dev/null; then
            PYTHON_CMD="python3"
        elif command -v python &>/dev/null; then
            PYTHON_CMD="python"
        fi
    fi
fi

if [ -z "$PYTHON_CMD" ]; then
    open index.html
    exit 0
fi

# Check if server is already running on port 8642
if ! lsof -i :8642 &>/dev/null; then
    nohup "$PYTHON_CMD" server.py --no-browser >/dev/null 2>&1 &
    sleep 0.8
fi

# Open game in default web browser
open "http://localhost:8642"
